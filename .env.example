# Copy this file to .env and replace every placeholder with a secret from your deployment environment.
# Never commit .env or real credentials to the repository.
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

TURSO_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# Cloudinary - 3 Accounts (use separate accounts or the same account as appropriate)
CLOUDINARY_PRODUCT_NAME=your-cloudinary-cloud-name
CLOUDINARY_PRODUCT_KEY=your-cloudinary-api-key
CLOUDINARY_PRODUCT_SECRET=replace-with-your-cloudinary-api-secret
CLOUDINARY_CHAT_NAME=your-cloudinary-cloud-name
CLOUDINARY_CHAT_KEY=your-cloudinary-api-key
CLOUDINARY_CHAT_SECRET=replace-with-your-cloudinary-api-secret
CLOUDINARY_RESELL_NAME=your-cloudinary-cloud-name
CLOUDINARY_RESELL_KEY=your-cloudinary-api-key
CLOUDINARY_RESELL_SECRET=replace-with-your-cloudinary-api-secret

# Telegram - 2 Bots
TELEGRAM_BOT1_TOKEN=your-bot1-token
TELEGRAM_BOT2_TOKEN=your-bot2-token

# Gemini (optional)
GEMINI_API_KEY=your-gemini-api-key

# Web Push (the public key may also be embedded in the frontend)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
