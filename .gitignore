# ============================================
# SAR PAY ZONE - .gitignore
# ============================================

# ============================================
# 1. DEPENDENCIES
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# 2. ENVIRONMENT VARIABLES (အရေးကြီးဆုံး)
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env.staging

# ============================================
# 3. DATABASE FILES
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
.turso/
turso.db
*.turso

# ============================================
# 4. LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pm2/

# ============================================
# 5. OS FILES
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
*.swp
*.swo
*.swn

# ============================================
# 6. IDE / EDITOR
# ============================================
# VS Code
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / WebStorm
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# Vim
*.swp
*.swo
*.swn
*~

# ============================================
# 7. BUILD / DIST
# ============================================
dist/
build/
out/
*.min.js
*.min.css
*.bundle.js
*.bundle.css
*.map

# ============================================
# 8. CACHE FILES
# ============================================
.cache/
.parcel-cache/
.next/
.nuxt/
.nx/
.eslintcache
*.tsbuildinfo
*.tgz

# ============================================
